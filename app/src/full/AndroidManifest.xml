<?xml version="1.0" encoding="utf-8"?>
<!-- Only in the "full" APK: these are the permissions Play Protect flags on sideloaded apps. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application>
        <!-- Start menu ⬇ Update: hands the downloaded reverender_95.apk to the system installer -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.update"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>

        <!-- Win95/Longhorn notification dialogs (only after the user grants notification access) -->
        <service
            android:name=".os.RetroNotificationService"
            android:exported="true"
            android:label="REVERENDER_95 retro alerts"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
