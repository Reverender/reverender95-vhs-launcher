<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Android integrations -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- VHS swipe down: pull down the phone's notification shade (a normal permission, no prompt) -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- long-press a phone app → Uninstall (Android shows its own confirmation) -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- taskbar clock → the phone's clock app -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-feature android:name="android.software.midi" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />
    <uses-feature android:name="android.software.live_wallpaper" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- Start menu "Phone Apps": list the phone's launchable apps (Android 11+ package visibility) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="false"
        android:theme="@style/Theme.Reverender95">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Win95 Home Launcher Mode: off until switched on in Settings (Control Panel) -->
        <activity-alias
            android:name=".HomeAlias"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- Properties sheets opened from Android's live-wallpaper and screen-saver settings -->
        <activity android:name=".ui.apps.LiveWallpaperSettingsActivity" android:exported="true" android:label="@string/live_wp_name" android:taskAffinity="com.reverender.r95.osprops" android:excludeFromRecents="true" />
        <activity android:name=".ui.apps.DreamSettingsActivity" android:exported="true" android:label="@string/dream_name" android:taskAffinity="com.reverender.r95.osprops" android:excludeFromRecents="true" />

        <!-- CRT dock screensaver -->
        <service
            android:name=".os.R95Dream"
            android:exported="true"
            android:label="@string/dream_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="android.service.dream" android:resource="@xml/dream" />
        </service>

        <!-- Audio-reactive live wallpaper -->
        <service
            android:name=".os.R95LiveWallpaper"
            android:exported="true"
            android:label="@string/live_wp_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/live_wallpaper" />
        </service>


        <!-- System EQ: other players announce their audio sessions -->
        <receiver android:name=".audio.EffectSessionReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.media.action.OPEN_AUDIO_EFFECT_CONTROL_SESSION" />
                <action android:name="android.media.action.CLOSE_AUDIO_EFFECT_CONTROL_SESSION" />
            </intent-filter>
        </receiver>

        <!-- Office Plaza reminders / focus alarm / pinned notes -->
        <receiver android:name=".os.OfficeAlarmReceiver" android:exported="false" />

        <!-- Home screen widgets -->
        <receiver android:name=".os.WidgetActionReceiver" android:exported="false" />
        <receiver android:name=".os.CassetteWidget" android:exported="true" android:label="@string/widget_cassette">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_cassette" />
        </receiver>
        <receiver android:name=".os.AmpWidget" android:exported="true" android:label="@string/widget_amp">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_amp" />
        </receiver>
        <receiver android:name=".os.FxWidget" android:exported="true" android:label="@string/widget_fx">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_fx" />
        </receiver>
        <receiver android:name=".os.VuWidget" android:exported="true" android:label="@string/widget_vu">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_vu" />
        </receiver>

        <!-- Use the bundled emoji font instead of the downloadable one (works offline and on old phones). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
        </provider>

        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.reverender.r95.audio.CastOptionsProvider" />

        <service
            android:name=".audio.VhsKeepAlive"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <service
            android:name=".audio.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
            <service
            android:name=".audio.ProjectionService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>
</manifest>
