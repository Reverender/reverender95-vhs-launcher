<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@drawable/w95_window" android:padding="3dp">
    <include layout="@layout/w95_titlebar"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical"
        android:layout_marginTop="3dp" android:background="@drawable/w95_lcd" android:padding="5dp">
        <TextView android:id="@+id/w_time" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#FF00F7FF" android:fontFamily="monospace" android:textSize="18sp" android:textStyle="bold" android:singleLine="true"/>
        <TextView android:id="@+id/w_track" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#FFFF00A0" android:fontFamily="monospace" android:textSize="11sp" android:maxLines="2" android:ellipsize="end"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="34dp" android:orientation="horizontal" android:layout_marginTop="3dp">
        <TextView android:id="@+id/w_prev" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:background="@drawable/w95_button" android:gravity="center" android:text="⏮" android:textColor="#FF000000" android:textSize="14sp" android:textStyle="bold" android:singleLine="true"/>
        <TextView android:id="@+id/w_play" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:background="@drawable/w95_button" android:gravity="center" android:text="▶" android:textColor="#FF000000" android:textSize="15sp" android:textStyle="bold" android:singleLine="true"/>
        <TextView android:id="@+id/w_stop" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:background="@drawable/w95_button" android:gravity="center" android:text="■" android:textColor="#FF000000" android:textSize="15sp" android:textStyle="bold" android:singleLine="true"/>
        <TextView android:id="@+id/w_next" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:background="@drawable/w95_button" android:gravity="center" android:text="⏭" android:textColor="#FF000000" android:textSize="14sp" android:textStyle="bold" android:singleLine="true"/>
        <TextView android:id="@+id/w_open" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:background="@drawable/w95_button" android:gravity="center" android:text="🌴" android:textColor="#FF000000" android:textSize="14sp" android:textStyle="bold" android:singleLine="true"/>
    </LinearLayout>
</LinearLayout>
